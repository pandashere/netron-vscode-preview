{
  "name": "netron-vscode-preview",
  "displayName": "Netron VSCode Workbench",
  "description": "Preview ONNX models in VS Code with host-managed crop, export, inference, and compare workflows.",
  "version": "0.1.0",
  "publisher": "local",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pandashere/netron-vscode-preview.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Visualization",
    "Machine Learning"
  ],
  "main": "./extension.js",
  "scripts": {
    "package:vsix": "npx @vscode/vsce package -o dist/netron-vscode-workbench-0.1.0.vsix",
    "install:vsix": "code --install-extension dist/netron-vscode-workbench-0.1.0.vsix --force",
    "verify:vsix": "code --list-extensions --show-versions",
    "generate:testmodels": "python3 scripts/generate_onnx_test_models.py --output-dir testdata/generated",
    "generate:vit-unet-3200": "python3 scripts/generate_vit_unet_3200_model.py",
    "benchmark:vit-unet-layout": "python3 scripts/benchmark_vit_unet_layout.py",
    "qa:install-ai-tools": "node scripts/install_manual_ai_tools.js",
    "qa:install-graph-deepseek-tools": "node scripts/install_graph_deepseek_tools.js",
    "smoke:all": "node scripts/smoke_all.js",
    "smoke:extension-activation": "node scripts/smoke_extension_activation.js",
    "smoke:extension-provider-api": "node scripts/smoke_extension_provider_api.js",
    "smoke:provider-artifact-export": "node scripts/smoke_provider_artifact_export.js",
    "smoke:package-manifest": "node scripts/smoke_package_manifest.js",
    "smoke:webview-contract": "node scripts/smoke_webview_contract.js",
    "smoke:compare-internal": "node scripts/smoke_compare_internal_io.js",
    "smoke:compare-core": "node scripts/smoke_compare_core.js",
    "smoke:compare-engine": "node scripts/smoke_compare_engine.js",
    "smoke:host-compare-state": "node scripts/smoke_host_compare_state.js",
    "smoke:private-provider-contract": "node scripts/smoke_private_provider_contract.js",
    "smoke:dev-ir-provider": "node scripts/smoke_dev_ir_provider.js",
    "smoke:manual-ai-tools": "node scripts/smoke_manual_ai_tools.js",
    "smoke:graph-deepseek-tools": "node scripts/smoke_graph_deepseek_tools.js",
    "smoke:copy-export-host-flow": "node scripts/smoke_copy_export_host_flow.js",
    "smoke:ai-analysis-state": "node scripts/smoke_ai_analysis_state.js",
    "smoke:ai-panel-contract": "node scripts/smoke_ai_panel_contract.js",
    "smoke:ai-task-host-flow": "node scripts/smoke_ai_task_host_flow.js",
    "smoke:core-text-export-context": "node scripts/smoke_core_text_export_context.js",
    "smoke:text-export-context": "node scripts/smoke_text_export_context.js",
    "smoke:cli-tools": "node scripts/smoke_cli_tools.js",
    "smoke:provider-registry": "node scripts/smoke_provider_registry.js",
    "smoke:private-ir-guide-examples": "node scripts/smoke_private_ir_guide_examples.js"
  },
  "activationEvents": [
    "onCommand:netronPreview.openPreview",
    "onView:netronCompare.compareView",
    "onView:netronAI.analysisView",
    "onCommand:netronPreview.openCompareCenter",
    "onCommand:netronPreview.openAiAnalysis",
    "onCommand:netronPreview.clearCompareCenter"
  ],
  "contributes": {
    "commands": [
      {
        "command": "netronPreview.openPreview",
        "title": "Netron: Preview Model"
      },
      {
        "command": "netronPreview.openCompareCenter",
        "title": "Netron: Focus Compare"
      },
      {
        "command": "netronPreview.openAiAnalysis",
        "title": "Netron: Focus AI Analysis"
      },
      {
        "command": "netronPreview.clearCompareCenter",
        "title": "Netron: Clear Compare"
      }
    ],
    "viewsContainers": {
      "panel": [
        {
          "id": "netronComparePanel",
          "title": "Netron Compare",
          "icon": "media/netron-compare.svg"
        }
      ]
    },
    "views": {
      "netronComparePanel": [
        {
          "type": "webview",
          "id": "netronCompare.compareView",
          "name": "Compare"
        },
        {
          "type": "webview",
          "id": "netronAI.analysisView",
          "name": "AI Analysis"
        }
      ]
    },
    "menus": {
      "explorer/context": [
        {
          "command": "netronPreview.openPreview",
          "when": "resourceScheme == file",
          "group": "navigation@100"
        }
      ]
    }
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "onnx-proto": "^8.0.1",
    "onnxruntime-node": "^1.24.3"
  }
}
